# Host port exposed to MCP clients.
HOST_PORT=8080

# User/group the container process runs as. Defaults to root (0) so the
# bind-mounted ./config dir (auto-created as root by Docker) is always
# writable. If you set non-root values here, create/chown ./config
# accordingly BEFORE `docker compose up`:
#   mkdir -p config && sudo chown -R <uid>:<gid> config
# OPENAPI_MCP_UID=1000
# OPENAPI_MCP_GID=1000

# Container timezone.
TZ=Europe/Madrid

# --- API keys ----------------------------------------------------------------
# Any target may reference a key by env name at runtime (APIKeyEnv). Declare
# those here, e.g.:
# WEATHER_API_KEY=