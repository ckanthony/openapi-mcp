{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "openapi-mcp": {
      "type": "remote",
      "url": "http://localhost:8086/mcp",
      "enabled": true
    },
    "mcp-debugger": {
      "type": "local",
      "command": [
        "mcp-debugger",
        "stdio"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--headless",
        "--isolated"
      ],
      "enabled": true
    }
  }
}
