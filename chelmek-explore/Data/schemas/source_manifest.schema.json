{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chelmek-explore.local/schemas/source_manifest.schema.json",
  "title": "Data/Geo/source_manifest.json (SCHEMA_VERSION 1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bbox", "origin", "crs", "sources"],
  "properties": {
    "schema_version": { "type": "string" },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat_min", "lat_max", "lon_min", "lon_max"],
      "properties": {
        "lat_min": { "const": 50.0881157 },
        "lat_max": { "const": 50.1341934 },
        "lon_min": { "const": 19.2227522 },
        "lon_max": { "const": 19.2773330 }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "epsg2180_x", "epsg2180_y"],
      "properties": {
        "lat": { "const": 50.1003348 },
        "lon": { "const": 19.2542585 },
        "epsg2180_x": { "type": "number" },
        "epsg2180_y": { "type": "number" }
      }
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "working", "engine", "unit"],
      "properties": {
        "source": { "const": "EPSG:4326" },
        "working": { "const": "EPSG:2180" },
        "engine": { "const": "local ENU" },
        "unit": { "const": "cm" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "layer", "provider", "license", "url",
          "retrieved_at", "status"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "layer": {
            "type": "string",
            "enum": [
              "terrain", "buildings", "roads", "addresses", "landcover",
              "poi", "plans", "ortho", "scans"
            ]
          },
          "provider": { "type": "string" },
          "license": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["present", "not-downloaded", "blocked", "superseded"]
          },
          "local_path": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
